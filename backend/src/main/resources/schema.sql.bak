-- 1. pgvector 확장 활성화 (RAG 임베딩 검색을 위해 필수)
-- CREATE EXTENSION IF NOT EXISTS vector;

-- 2. 기존 테이블 삭제 (초기화용 - 필요 없으면 삭제하세요)
DROP TABLE IF EXISTS RAG_CHUNKS;
DROP TABLE IF EXISTS RAG_DOCUMENTS;
DROP TABLE IF EXISTS MEETING_NOTES;
DROP TABLE IF EXISTS TASKS;
DROP TABLE IF EXISTS SCHEDULES;
DROP TABLE IF EXISTS NOTICES;
DROP TABLE IF EXISTS TEAM_MEMBERS;
DROP TABLE IF EXISTS TEAMS;
DROP TABLE IF EXISTS USERS;

-- 3. USERS (사용자)
CREATE TABLE USERS (
    id BIGSERIAL PRIMARY KEY,
    email VARCHAR(255) UNIQUE NOT NULL,
    password VARCHAR(255) NOT NULL,
    name VARCHAR(100) NOT NULL,
    student_id VARCHAR(50) UNIQUE NOT NULL,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

-- 4. TEAMS (팀)
CREATE TABLE TEAMS (
    id BIGSERIAL PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    course_name VARCHAR(255),
    description TEXT,
    join_code VARCHAR(20) UNIQUE NOT NULL,
    owner_id BIGINT NOT NULL,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_team_owner FOREIGN KEY (owner_id) REFERENCES USERS(id) ON DELETE CASCADE
);

-- 5. TEAM_MEMBERS (팀 멤버 관계)
CREATE TABLE TEAM_MEMBERS (
    id BIGSERIAL PRIMARY KEY,
    team_id BIGINT NOT NULL,
    user_id BIGINT NOT NULL,
    role VARCHAR(50) DEFAULT 'MEMBER',
    joined_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_member_team FOREIGN KEY (team_id) REFERENCES TEAMS(id) ON DELETE CASCADE,
    CONSTRAINT fk_member_user FOREIGN KEY (user_id) REFERENCES USERS(id) ON DELETE CASCADE,
    UNIQUE (team_id, user_id)
);

-- 6. NOTICES (공지사항)
CREATE TABLE NOTICES (
    id BIGSERIAL PRIMARY KEY,
    team_id BIGINT NOT NULL,
    author_id BIGINT NOT NULL,
    title VARCHAR(255) NOT NULL,
    content TEXT NOT NULL,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_notice_team FOREIGN KEY (team_id) REFERENCES TEAMS(id) ON DELETE CASCADE,
    CONSTRAINT fk_notice_author FOREIGN KEY (author_id) REFERENCES USERS(id) ON DELETE SET NULL
);

-- 7. SCHEDULES (일정)
CREATE TABLE SCHEDULES (
    id BIGSERIAL PRIMARY KEY,
    team_id BIGINT NOT NULL,
    author_id BIGINT NOT NULL,
    title VARCHAR(255) NOT NULL,
    description TEXT,
    start_date_time TIMESTAMPTZ NOT NULL,
    end_date_time TIMESTAMPTZ NOT NULL,
    location VARCHAR(255),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_schedule_team FOREIGN KEY (team_id) REFERENCES TEAMS(id) ON DELETE CASCADE,
    CONSTRAINT fk_schedule_author FOREIGN KEY (author_id) REFERENCES USERS(id) ON DELETE SET NULL
);

-- 8. TASKS (할 일)
CREATE TABLE TASKS (
    id BIGSERIAL PRIMARY KEY,
    team_id BIGINT NOT NULL,
    author_id BIGINT NOT NULL,
    assignee_id BIGINT,
    title VARCHAR(255) NOT NULL,
    description TEXT,
    due_date DATE,
    status VARCHAR(50) DEFAULT 'TODO', -- TODO, IN_PROGRESS, DONE
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_task_team FOREIGN KEY (team_id) REFERENCES TEAMS(id) ON DELETE CASCADE,
    CONSTRAINT fk_task_author FOREIGN KEY (author_id) REFERENCES USERS(id) ON DELETE SET NULL,
    CONSTRAINT fk_task_assignee FOREIGN KEY (assignee_id) REFERENCES USERS(id) ON DELETE SET NULL
);

-- 9. MEETING_NOTES (회의록)
CREATE TABLE MEETING_NOTES (
    id BIGSERIAL PRIMARY KEY,
    team_id BIGINT NOT NULL,
    author_id BIGINT NOT NULL,
    title VARCHAR(255) NOT NULL,
    content TEXT NOT NULL,
    meeting_date DATE NOT NULL,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_note_team FOREIGN KEY (team_id) REFERENCES TEAMS(id) ON DELETE CASCADE,
    CONSTRAINT fk_note_author FOREIGN KEY (author_id) REFERENCES USERS(id) ON DELETE SET NULL
);

-- 10. RAG_DOCUMENTS (RAG 원본 문서)
CREATE TABLE RAG_DOCUMENTS (
    id BIGSERIAL PRIMARY KEY,
    team_id BIGINT NOT NULL,
    source_type VARCHAR(50), -- 'NOTICE', 'MEETING_NOTE' 등
    source_id BIGINT,
    title VARCHAR(255),
    content TEXT NOT NULL,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_doc_team FOREIGN KEY (team_id) REFERENCES TEAMS(id) ON DELETE CASCADE
);

-- 11. RAG_CHUNKS (벡터화된 조각 데이터)
/* H2 호환을 위해 임시 주석 처리
CREATE TABLE RAG_CHUNKS (
    id BIGSERIAL PRIMARY KEY,
    document_id BIGINT NOT NULL,
    team_id BIGINT NOT NULL,
    chunk_index INT NOT NULL,
    chunk_text TEXT NOT NULL,
    embedding vector(1536), -- OpenAI 임베딩 모델(text-embedding-3-small 등) 기준
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_chunk_doc FOREIGN KEY (document_id) REFERENCES RAG_DOCUMENTS(id) ON DELETE CASCADE,
    CONSTRAINT fk_chunk_team FOREIGN KEY (team_id) REFERENCES TEAMS(id) ON DELETE CASCADE
);

